{
  "expo": {
    "name": "DropTrack",
    "slug": "droptrack-dropper",
    "scheme": "droptrackdropper",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1029"
    },
    "ios": {
      "bundleIdentifier": "au.com.droptrack.dropper",
      "buildNumber": "9",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DropTrack uses your location to track drops you make during your shift and confirm coverage of the campaign zone.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "DropTrack records your route in the background while a delivery is active so the client can verify coverage and you can pause/resume any time.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "app.droptrack.com.au",
      "versionCode": 9,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1029"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DropTrack to record your route while a delivery is active.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://portal.droptrack.com.au",
      "eas": {
        "projectId": "caa65996-b020-4058-a0f6-615d9910f885"
      }
    },
    "owner": "poonam_thelinetech"
  }
}
